{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**"]
    },
    "type-check": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    }
  }
}
