# Copy to .env and adjust as needed. Values here are LOCAL-DEV DEFAULTS, not real secrets.
# Never commit a real .env (it is git-ignored).

# --- PostgreSQL (local Docker Compose) ---
POSTGRES_USER=paypilot
POSTGRES_PASSWORD=paypilot
POSTGRES_DB=paypilot
POSTGRES_PORT=5432

# --- API database connection (Prisma) ---
DATABASE_URL=postgresql://paypilot:paypilot@localhost:5432/paypilot?schema=public

# --- API runtime ---
NODE_ENV=development
PORT=3000
# API_PREFIX=api
# API_VERSION=1

# --- Business timezone ---
# IANA zone used to derive "today" and the current month (dashboard, payment
# dates, reminders, recurring-bill generation). Invalid names fail startup.
APP_TIME_ZONE="America/Sao_Paulo"

# --- Auth / JWT ---
# JWT_SECRET must be a randomly generated secret with >=256 bits of entropy,
# preferably base64/base64url. Generate one with:  openssl rand -base64 48
# Placeholders/weak values are rejected at startup in non-test environments.
JWT_SECRET="<replace-with-256-bit-random-secret>"
JWT_ACCESS_TTL="15m"               # short-lived access token (allowed: 5m..1h)

# --- Auth rate limits (per client IP; windows parsed by `ms`) ---
AUTH_LOGIN_RATE_LIMIT_POINTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW="1m"
AUTH_REGISTER_RATE_LIMIT_POINTS=3
AUTH_REGISTER_RATE_LIMIT_WINDOW="1m"
AUTH_DEFAULT_RATE_LIMIT_POINTS=100
AUTH_DEFAULT_RATE_LIMIT_WINDOW="1m"

# --- Notifications (due-date reminders) ---
# Provider defaults to "log" (fake provider — no real messages, no credentials).
# Setting "whatsapp" REQUIRES both credentials below (validated at startup).
# NOTIFICATION_PROVIDER=log
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Web (Next.js) ---
# PUBLIC by design (inlined into the browser bundle) — never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
