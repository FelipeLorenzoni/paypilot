{
  "name": "paypilot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test test:integration",
    "test:unit": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @paypilot/api db:generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:ci": "pnpm install --frozen-lockfile",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:prod": "pnpm audit --prod --audit-level high",
    "security:approve-builds": "pnpm approve-builds"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.1",
    "turbo": "2.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  }
}
