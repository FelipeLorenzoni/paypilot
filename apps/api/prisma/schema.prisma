// PayPilot database schema.
//
// Foundation scope: datasource + generator plumbing only. NO business models
// are defined here (no fake/placeholder models). Feature specs add models via
// their own Prisma migrations following the conventions in docs/conventions.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (Migrate/CLI) and is
  // supplied at runtime via the @prisma/adapter-pg driver adapter (PrismaService).
}

// First model (auth-jwt). Email is stored normalized (trim+lowercase); the
// unique index is the race-safe source of truth for duplicate registration.
// `isActive` supports disabled-user rejection. Timestamps are UTC per
// docs/conventions.md.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  transactions   Transaction[]
  recurringBills RecurringBill[]
  creditCards    CreditCard[]
  cardPurchases  CardPurchase[]
  importRuns     ImportRun[]
  reminderSettings   ReminderSettings?
  paymentMarkers     PaymentMarker[]
  reminderDeliveries ReminderDelivery[]

  @@map("users")
}

// Generic transaction ledger (manual-expenses). Internal field names are
// generic (`transactionDate`, `categoryLabel`); the expenses API maps them to
// `expenseDate`/`category`. Money is BIGINT minor units (> 0); dates are
// date-only; audit timestamps are UTC. `onDelete: Restrict` — no purge via user
// deletion in this spec.
enum TransactionType {
  EXPENSE
}

enum TransactionSource {
  MANUAL
  RECURRING
  CARD
  IMPORTED
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  type            TransactionType
  source          TransactionSource
  amountMinor     BigInt
  currency        String            @db.Char(3)
  transactionDate DateTime          @db.Date
  description     String            @db.VarChar(255)
  categoryLabel   String?           @db.VarChar(100)
  // Recurring-bill link (recurring-bills). NULL for MANUAL rows; both set for
  // RECURRING rows. The composite unique gives the DB-level idempotency
  // guarantee (financial-rules R3): at most one generated row per (bill,
  // period). Postgres treats NULLs as distinct, so MANUAL rows never collide.
  // A CHECK constraint (added in the migration) enforces the valid link states.
  recurringBillId String?           @db.Uuid
  recurringBill   RecurringBill?    @relation(fields: [recurringBillId], references: [id], onDelete: Restrict)
  periodKey       String?           @db.Char(7) // "YYYY-MM"
  // Credit-card link (credit-cards-invoices). NULL for non-CARD rows; all set
  // for CARD rows. `invoiceCycle` is the closing month "YYYY-MM"; `transactionDate`
  // for a CARD row is the cycle's due date. The source-aware CHECK constraint
  // (added in the migration) enforces the valid per-source link states, incl.
  // the installment invariants (1 <= seq <= total).
  creditCardId     String?          @db.Uuid
  creditCard       CreditCard?      @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  cardPurchaseId   String?          @db.Uuid
  cardPurchase     CardPurchase?    @relation(fields: [cardPurchaseId], references: [id], onDelete: Restrict)
  invoiceCycle     String?          @db.Char(7) // "YYYY-MM" (closing month)
  installmentSeq   Int?             @db.SmallInt
  installmentTotal Int?             @db.SmallInt
  // CSV-import link (csv-import). NULL for non-IMPORTED rows; both set for
  // IMPORTED rows. `dedupHash` is sha-256 of the normalized (date, amountMinor,
  // description) dedup key; a PARTIAL UNIQUE index (userId, dedupHash) WHERE
  // source = 'IMPORTED' (raw SQL in the migration — Prisma cannot express the
  // WHERE) is the DB-level R6 duplicate guarantee, scoped per user to imported
  // rows only. The source-aware CHECK enforces the valid per-source link states.
  dedupHash        String?          @db.Char(64)
  importRunId      String?          @db.Uuid
  importRun        ImportRun?       @relation(fields: [importRunId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  // Reminder-side inverse relations (due-date-reminders). Schema-file-only —
  // the reminder tables reference RECURRING rows; no column is added here.
  paymentMarkers     PaymentMarker[]
  reminderDeliveries ReminderDelivery[]

  @@unique([recurringBillId, periodKey])
  @@index([userId, transactionDate, id])
  @@index([creditCardId, invoiceCycle])
  @@map("transactions")
}

// Recurring monthly bill definition (recurring-bills). Money is BIGINT minor
// units (> 0); `dayOfMonth` is 1–31 (clamped to month length at generation);
// `startDate`/`endDate` are date-only; audit timestamps are UTC. `isActive`
// supports deactivation (DELETE deactivates rather than hard-deletes, to
// preserve generated history). `onDelete: Restrict` — generated transactions
// reference the bill, so a bill can't be removed out from under them.
model RecurringBill {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountMinor   BigInt
  currency      String        @db.Char(3)
  dayOfMonth    Int           @db.SmallInt
  description   String        @db.VarChar(255)
  categoryLabel String?       @db.VarChar(100)
  startDate     DateTime      @db.Date
  endDate       DateTime?     @db.Date
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  transactions  Transaction[]

  @@index([userId])
  @@map("recurring_bills")
}

// Credit card (credit-cards-invoices). `closingDay`/`dueDay` are 1–31 (clamped
// to month length during assignment); `creditLimitMinor` is optional BIGINT
// minor units (available-limit checks are out of scope). `isActive` supports
// deactivation (DELETE deactivates rather than hard-deletes, preserving
// generated card transactions). `onDelete: Restrict` — generated rows/purchases
// reference the card.
model CreditCard {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  label            String         @db.VarChar(100)
  closingDay       Int            @db.SmallInt
  dueDay           Int            @db.SmallInt
  creditLimitMinor BigInt?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  purchases        CardPurchase[]
  transactions     Transaction[]
  paymentMarkers     PaymentMarker[]
  reminderDeliveries ReminderDelivery[]

  @@index([userId])
  @@map("credit_cards")
}

// Originating purchase / installment plan (credit-cards-invoices). One row per
// recorded purchase; every generated CARD `Transaction` links back via
// `cardPurchaseId`. `idempotencyKey` + `@@unique([userId, idempotencyKey])` is
// the DB-level idempotency guarantee (R13); `requestHash` is a sha-256 of the
// normalized full payload used to reconcile key reuse (return existing vs 409).
// `startCycle` is the assigned first invoice cycle "YYYY-MM". `onDelete: Restrict`.
model CardPurchase {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditCardId   String        @db.Uuid
  creditCard     CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  idempotencyKey String        @db.VarChar(200)
  requestHash    String        @db.Char(64)
  purchaseDate   DateTime      @db.Date
  amountMinor    BigInt
  currency       String        @db.Char(3)
  description    String        @db.VarChar(255)
  categoryLabel  String?       @db.VarChar(100)
  installments   Int           @db.SmallInt
  startCycle     String        @db.Char(7) // "YYYY-MM"
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  transactions   Transaction[]

  @@unique([userId, idempotencyKey])
  @@index([creditCardId])
  @@map("card_purchases")
}

// Import run / provenance (csv-import). One row per structurally valid import
// file; every IMPORTED Transaction links back via `importRunId`. Counts are the
// DB-derived per-file summary. `fileHash` is an optional sha-256 of the file
// bytes; the raw CSV body is NEVER stored. FAILED is intentionally absent in
// the MVP: structural failures persist nothing (no run), and the atomic
// run+rows transaction means an observer only ever sees COMPLETED (PROCESSING
// is transient inside the transaction); a FAILED status arrives with a future
// async-import spec, if any. `onDelete: Restrict`.
enum ImportStatus {
  PROCESSING
  COMPLETED
}

model ImportRun {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         ImportStatus  @default(PROCESSING)
  totalRows      Int           @default(0)
  importedCount  Int           @default(0)
  duplicateCount Int           @default(0)
  invalidCount   Int           @default(0)
  fileHash       String?       @db.Char(64)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  transactions   Transaction[]

  @@index([userId])
  @@map("import_runs")
}

// ---------------------------------------------------------------------------
// due-date-reminders. Three side tables — the ledger is untouched (only the
// inverse relation fields above, which generate no SQL). Target identity is
// canonical: `targetType` + `targetKey` ("txn:<transactionId>" for
// RECURRING_TRANSACTION, "card:<creditCardId>:<invoiceCycle>" for
// CARD_INVOICE, server-derived only) plus typed FK columns for referential
// integrity; a CHECK per targetType (raw SQL in the migration) enforces that
// exactly the matching typed columns are set.
// ---------------------------------------------------------------------------

enum ReminderTargetType {
  RECURRING_TRANSACTION
  CARD_INVOICE
}

// Part of the ReminderDelivery identity from day one (R2) so future channels
// need no schema change. MVP ships WhatsApp only.
enum NotificationChannel {
  WHATSAPP
}

// PENDING is the in-flight claim; SENT/SKIPPED are terminal forever (a
// paid->unpaid flip never re-opens a consumed identity); FAILED and stale
// PENDING are re-claimable (one attempt at a time).
enum ReminderDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Per-user reminder settings (1:1). `enabled` defaults to false (opt-in);
// a user without a row (or without a phone) is skipped, never errored.
// The phone number is E.164 and is never logged unmasked.
model ReminderSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  phoneE164 String?  @db.VarChar(16)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("reminder_settings")
}

// Paid marker — row presence = paid (unmark deletes; both idempotent).
// Invoice-level for cards: one marker per (userId, card, cycle) covers the
// whole invoice. Never mutates ledger rows. Written only by bill-payments;
// read by reminders (R1) and the monthly dashboard.
model PaymentMarker {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  targetType    ReminderTargetType
  targetKey     String             @db.VarChar(90)
  transactionId String?            @db.Uuid
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  creditCardId  String?            @db.Uuid
  creditCard    CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  invoiceCycle  String?            @db.Char(7)
  // When the marker was recorded (Clock.now() at mark time).
  paidAt        DateTime           @db.Timestamptz(6)
  // Payment date chosen by the user (bill-payments); date-only, never in the
  // future. Back-filled from the UTC date of `paidAt` for older markers.
  paidOn        DateTime           @db.Date
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)

  @@unique([userId, targetType, targetKey])
  @@index([userId])
  @@map("payment_markers")
}

// One logical reminder delivery per R2 identity. The composite unique index is
// the DB-level R2 guarantee: at most one successful RECORDED delivery per
// (userId, targetType, targetKey, dueDate, windowDaysBefore, channel). True
// exactly-once EXTERNAL delivery is out of scope for this spec (stub/log
// providers only); a future real-provider spec must add provider idempotency
// or delivery confirmation. `errorCode` is a stable code only — never message
// bodies or PII.
model ReminderDelivery {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  targetType       ReminderTargetType
  targetKey        String                 @db.VarChar(90)
  transactionId    String?                @db.Uuid
  transaction      Transaction?           @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  creditCardId     String?                @db.Uuid
  creditCard       CreditCard?            @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  invoiceCycle     String?                @db.Char(7)
  dueDate          DateTime               @db.Date
  windowDaysBefore Int                    @db.SmallInt
  channel          NotificationChannel
  status           ReminderDeliveryStatus @default(PENDING)
  attempt          Int                    @default(1)
  errorCode        String?                @db.VarChar(64)
  sentAt           DateTime?              @db.Timestamptz(6)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(6)

  @@unique([userId, targetType, targetKey, dueDate, windowDaysBefore, channel], map: "reminder_deliveries_identity_uq")
  @@index([userId])
  @@map("reminder_deliveries")
}
